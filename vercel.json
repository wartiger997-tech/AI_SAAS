{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/contract-redliner/web",
      "framework": "nextjs",
      "installCommand": "npm ci --no-audit --no-fund",
      "buildCommand": "npm run build"
    },
    "clause-api": {
      "root": "apps/contract-redliner/api",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "installCommand": "pip install .",
      "buildCommand": "python -c \"import main\""
    },
    "relay-api": {
      "root": "apps/voice-receptionist/api",
      "framework": "fastapi",
      "entrypoint": "main:app",
      "installCommand": "pip install .",
      "buildCommand": "python -c \"import main\""
    }
  },
  "rewrites": [
    {
      "source": "/api/clause(.*)",
      "destination": {
        "service": "clause-api"
      }
    },
    {
      "source": "/api/relay(.*)",
      "destination": {
        "service": "relay-api"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "daemons": {
    "receptionist-agent": {
      "root": "apps/voice-receptionist/agent",
      "entrypoint": "Dockerfile",
      "instances": {
        "iad1": 1
      },
      "bindings": [
        {
          "type": "service",
          "service": "relay-api",
          "format": "url",
          "env": "RELAY_API_URL"
        }
      ]
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
