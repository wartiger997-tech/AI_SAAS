# Root development environment (copy to .env for compose variable substitution).
# Service-specific configuration lives in apps/*/.env.example.

LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
RELAY_BUSINESS_ID=

# Optional Langfuse OTLP auth (base64 of public:secret) for the collector.
LANGFUSE_OTEL_AUTH=