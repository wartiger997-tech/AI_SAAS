# Relay API — example environment
ENV=dev
DATABASE_URL=postgresql+asyncpg://relay:relay@localhost:5432/relay
REDIS_URL=redis://localhost:6379/1

JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=720
INTERNAL_API_TOKEN=change-me-internal-token

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15550000000

# LiveKit
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_URI=sip:relay@sip.livekit.cloud;transport=tcp
AGENT_NAME=relay-receptionist

# Providers
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# OpenRouter free models are the default LLM.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free
# Optional OpenAI fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Booking / messaging
BOOKING_LINK_BASE_URL=http://localhost:8001
BOOKING_LEAD_MINUTES=60
DEFAULT_SLOT_MINUTES=30
DEFAULT_SERVICE_MINUTES=30
BOOKING_LINK_TTL_MINUTES=1440

# Storage
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=.data/storage
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Retention / safety
TRANSCRIPT_RETENTION_DAYS=90
RECORDING_RETENTION_DAYS=30
MAX_CALL_SECONDS=900
QUIET_HOURS_START=21
QUIET_HOURS_END=8

# Observability
LOG_LEVEL=INFO
LOG_JSON=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

CORS_ORIGINS=http://localhost:3000