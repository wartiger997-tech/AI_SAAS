# Relay agent — example environment
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Vercel Services injects RELAY_API_URL via a service binding. Do not set it.
# CONTROL_PLANE_URL is the local/Render fallback.
CONTROL_PLANE_URL=http://localhost:8001
RELAY_API_PREFIX=/v1
INTERNAL_API_TOKEN=change-me-internal-token
AGENT_NAME=relay-receptionist

# Fallback business when LiveKit job metadata does not include one.
RELAY_BUSINESS_ID=

LOG_LEVEL=INFO