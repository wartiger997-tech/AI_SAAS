# ClauseGuard API — example environment
ENV=dev
DATABASE_URL=postgresql+asyncpg://redliner:redliner@localhost:5432/redliner
REDIS_URL=redis://localhost:6379/0

JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_MINUTES=720

MAX_UPLOAD_MB=100
MAX_PAGES=300

STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=.data/storage
# S3 / MinIO
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# LLM — OpenRouter free models by default (no Claude/Anthropic)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=baidu/ernie-5.5-flash-preview:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free
# Optional: only used for embeddings if you want hosted vectors.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1-mini

EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# PDF extraction: local | llamaparse | unstructured
PDF_PROVIDER=local
LLAMACLOUD_API_KEY=
UNSTRUCTURED_API_KEY=

# Observability
LOG_LEVEL=INFO
LOG_JSON=true
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

CORS_ORIGINS=http://localhost:3000